import {
  "connect0459/almanac/core",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
}

options(
  targets: {
    "local_native.mbt": [ "native" ],
    "local_native_test.mbt": [ "native" ],
