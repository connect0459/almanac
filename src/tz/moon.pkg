    "local_js.mbt": [ "js" ],
    "local_js_test.mbt": [ "js" ],
    "local_wasm.mbt": [ "wasm", "wasm-gc" ],
    "local_wasm_test.mbt": [ "wasm", "wasm-gc" ],
  },
  "native-stub": [ "local_native_stub.c" ],
)
